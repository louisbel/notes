 style=&#34;text-align: left&#34;&gt;Miami 70.3 2017&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;00:54:36&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;02:47:05&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;02:01:30&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;05:43:11&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;Mont Tremblant 140.6 2017&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;01:07:07&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;05:51:57&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;04:32:25&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;11:31:29&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;Eagleman 70.3 2018&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;00:33:25&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;02:58:51&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;02:19:09&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;05:51:25&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;Atlantic City 70.3 2018&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: center&#34;&gt;00:34:35&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;—&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;—&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: right&#34;&gt;DNF&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;div style=&#34;margin-top:2rem;&#34;&gt;&#xA;&lt;div style=&#34;display:flex;gap:1rem;margin-bottom:0.5rem;font-size:0.75rem;color:#888;&#34;&gt;&#xA;  &lt;span style=&#34;display:flex;align-items:center;gap:4px;&#34;&gt;&lt;span s